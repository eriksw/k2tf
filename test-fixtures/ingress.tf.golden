resource "kubernetes_ingress_v1" "tls_example_ingress" {
  metadata {
    name = "tls-example-ingress"
  }
  spec {
    tls {
      hosts       = ["sslexample.foo.com"]
      secret_name = "testsecret-tls"
    }
    rule {
      host = "sslexample.foo.com"
      http {
        path {
          path = "/"
          backend {
          }
        }
      }
    }
  }
}
