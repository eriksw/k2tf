resource "kubernetes_role_binding_v1" "elasticsearch" {
  metadata {
    name = "elasticsearch"
  }
  subject {
    kind      = "ServiceAccount"
    name      = "elasticsearch"
    namespace = "default"
  }
  role_ref {
    api_group = "rbac.authorization.k8s.io"
    kind      = "Role"
    name      = "elasticsearch"
  }
}
